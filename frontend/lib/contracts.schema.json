          "title": "Name",
          "type": "string"
        },
        "email": {
          "default": "",
          "title": "Email",
          "type": "string"
        },
        "grade": {
          "default": "High school freshman",
          "title": "Grade",
          "type": "string"
        },
        "location": {
          "default": "Rocklin / Roseville, California",
          "title": "Location",
          "type": "string"
        },
        "resume": {
          "default": "",
          "maxLength": 20000,
          "title": "Resume",
          "type": "string"
        },
        "linkedin_url": {
          "default": "",
          "title": "Linkedin Url",
          "type": "string"
        },
        "portfolio_links": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Portfolio Links",
          "type": "array"
        },
        "projects": {
          "default": [
            "Built websites for local businesses"
          ],
          "items": {
            "type": "string"
          },
          "title": "Projects",
          "type": "array"
        },
        "awards": {
          "default": [
            "VEX Robotics World Championship competitor"
          ],
          "items": {
            "type": "string"
          },
          "title": "Awards",
          "type": "array"
        },
        "skills": {
          "default": [
            "Software development",
            "Web development",
            "Robotics"
          ],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "interests": {
          "default": [
            "Software",
            "AI",
            "Robotics",
            "Finance",
            "Startups",
            "Business"
          ],
          "items": {
            "type": "string"
          },
          "title": "Interests",
          "type": "array"
        },
        "cover_letter_snippets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cover Letter Snippets",
          "type": "array"
        },
        "background": {
          "default": "Strong academic profile",
          "title": "Background",
          "type": "string"
        },
        "voice_notes": {
          "default": "Direct, curious, friendly. No corporate praise. Sound like a real high-school student, not a sales pitch.",
          "maxLength": 2000,
          "title": "Voice Notes",
          "type": "string"
        },
        "writing_samples": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Writing Samples",
          "type": "array"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "title": "ProfileInput",
      "type": "object",
      "required": [
        "name",
        "email",
        "grade",
        "location",
        "resume",
        "linkedin_url",
        "portfolio_links",
        "projects",
        "awards",
        "skills",
        "interests",
        "cover_letter_snippets",
        "background",
        "voice_notes",
        "writing_samples",
        "verified"

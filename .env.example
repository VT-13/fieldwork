# Shared API + worker configuration. Keep actual secrets out of git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fieldwork:change-this-db-password@db:5432/fieldwork
POSTGRES_PASSWORD=change-this-db-password
API_KEY=replace-with-a-random-32-character-or-longer-secret
DASHBOARD_PASSWORD=replace-with-a-separate-long-password
APP_ORIGIN=http://localhost:3000
DRY_RUN=true
AUTO_APPROVE=false
DAILY_SEND_LIMIT=25
SEND_INTERVAL_SECONDS=120
TIMEZONE=America/Los_Angeles
DAILY_BUDGET_USD=5
COMPANY_BUDGET_USD=0.75
SEARCH_RESERVE_USD=0.03
SCRAPE_RESERVE_USD=0.02
CONTACT_RESERVE_USD=0.05
EXTRACT_RESERVE_USD=0.03
GENERATE_RESERVE_USD=0.15
REVIEW_RESERVE_USD=0.10
MAX_PAGES=5
RESEARCH_SECONDS=120
MAX_LLM_CALLS=7
SEARCH_COOLDOWN_DAYS=14
OPENAI_API_KEY=
CHEAP_MODEL=gpt-4.1-mini
WRITING_MODEL=gpt-4.1
REVIEW_MODEL=gpt-4.1
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
MAIL_PROVIDER=gmail
SENDER_EMAIL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
MICROSOFT_TENANT=common
# Personal manual desk disables all paid provider calls and live sending.
MANUAL_MODE=true

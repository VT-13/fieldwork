# Shared API + worker configuration. Keep actual secrets out of git.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fieldwork:change-this-db-password@db:5432/fieldwork
POSTGRES_PASSWORD=change-this-db-password
API_KEY=replace-with-a-random-32-character-or-longer-secret
# Private HTTPS origin is required when ENVIRONMENT=production.
APP_ORIGIN=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# security_setup.py generates private values; never paste real values into tracked files.
OPERATOR_PASSWORD_HASH=
CREDENTIAL_KEYS=
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]
SESSION_HOURS=12
MAX_REQUEST_BYTES=100000
RESPONSE_PREVIEW_RETENTION_DAYS=30
OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_DRAFTS_ENABLED=false
ALLOW_LEGACY_OAUTH=false
DATA_DIRECTORY=
RESPONSE_POLL_ENABLED=false
DRY_RUN=true
AUTO_APPROVE=false
DAILY_SEND_LIMIT=25
SEND_INTERVAL_SECONDS=120
TIMEZONE=America/Los_Angeles
DAILY_BUDGET_USD=5
COMPANY_BUDGET_USD=0.75
SEARCH_RESERVE_USD=0.03
SCRAPE_RESERVE_USD=0.02
CONTACT_RESERVE_USD=0.05
EXTRACT_RESERVE_USD=0.03
GENERATE_RESERVE_USD=0.15
REVIEW_RESERVE_USD=0.10
MAX_PAGES=5
RESEARCH_SECONDS=120
MAX_LLM_CALLS=7
SEARCH_COOLDOWN_DAYS=14
OPENAI_API_KEY=
CHEAP_MODEL=gpt-4.1-mini
WRITING_MODEL=gpt-4.1
REVIEW_MODEL=gpt-4.1
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_MAPS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
MAIL_PROVIDER=gmail
SENDER_EMAIL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Gmail refresh/access tokens belong in encrypted Integration storage, not .env.
MICROSOFT_TENANT=common
# Personal manual desk disables all paid provider calls and live sending.
MANUAL_MODE=true

# Module 4: bounded intelligence. These do not authorize paid services or sending.
DISCOVERY_SECONDS=60
DISCOVERY_BATCH_LIMIT=30
MAX_CONTACTS=5
MAX_PROVIDER_REQUESTS=16
MAX_INPUT_CHARS=12000
MAX_OUTPUT_TOKENS=1800
MAX_JOB_TOKENS=24000
DAILY_TOKEN_LIMIT=60000
DAILY_GENERATION_BUDGET_USD=3
MAX_GENERATION_ATTEMPTS=2
MAX_JOB_RETRIES=2
MODEL_ALLOWLIST=["gpt-4.1-mini","gpt-4.1"]
COMPANY_SIZE_PREFERENCE=["1-10","11-50","51-200"]
# AUTO_APPROVE is legacy configuration; Module 4 generated messages always need review.

# Module5 deterministic worker / mailbox bounds. No service is activated here.
WORKER_POLL_SECONDS=15
WORKER_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=600
MAILBOX_POLL_SECONDS=300
MAILBOX_MAX_REQUESTS=60
MAILBOX_MAX_MESSAGES=40
MAILBOX_LOOKBACK_DAYS=30
